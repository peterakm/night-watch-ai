# Night Watch AI defaults to a free, local model via Ollama - no API key
# needed. Just make sure `ollama serve` is running and the model below is
# pulled: `ollama pull qwen2.5:7b`
NIGHTWATCH_PROVIDER=ollama
NIGHTWATCH_MODEL=qwen2.5:7b
OLLAMA_HOST=http://localhost:11434

# Optional: switch to Claude via the Anthropic API instead (paid, better
# clinical-writing quality). Uncomment and fill in to use it:
# NIGHTWATCH_PROVIDER=anthropic
# NIGHTWATCH_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY=your-api-key-here
